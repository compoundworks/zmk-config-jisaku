/*
 * Jisaku v3.9 のキーマップ（2026-11-10 Claude が書いた最初の版）
 *
 * 元にした物: 4月の Keyball39 のキーマップ（~/qmk_firmware_old/keyboards/keyball/keyball39/keymaps/hiroyasu/keymap.c）
 *   と、Keyball39 の Remap の1枚目（大西配列）。層の番号と中身は Keyball39 と同じ並びにしてある。
 * 届いたら ZMK Studio（右手を USB でつないでブラウザで開く）で、ここを書き直さずに割り当てを変えられる。
 *
 * 並び（1行に左 → 右）:
 *   1行目  左 c1..c7 | 右 c1..c5
 *   2行目  左 c1..c7 | 右 c1..c6
 *   3行目  左 c1..c7 | 右 c0..c6
 *   4行目  左 c1 c2 c3 c4 c6 c7 c8 | 右 親指 t1 t2 t3・c4 c5 c6
 *   5行目  左の5方向キー FW1..FW5 | 右の5方向キー FW1..FW5（上・右・下・左・押し込み は仮。届いてから確かめる）
 * 左 c2..c6・右 c1..c5 の3行が Keyball39 の 5×3。左の c1 と c7・右の c0 と c6 と4行目の右3つは新しく増えた所（仮置き）。
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
};

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        /* ローラー（縦）と横回しホイール（横）でスクロール */
        scroll_v: scroll_v {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };
        scroll_h: scroll_h {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;
            tap-ms = <20>;
        };
    };

    macros {
        /* () を打って間に戻る（Keyball の MACRO_PAREN） */
        m_paren: m_paren {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
        };
        m_square: m_square {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
        };
        m_dquote: m_dquote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp DQT &kp LEFT>;
        };
    };

    /* Keyball の同時押し（QWERTY の位置で書かれていた J K・F D・S D を同じ位置に）。
       D F（やり直し）は F D（削除）と同じ2つのキーで、Keyball でも先に書いた削除しか出ていなかったので入れていない */
    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp ESC>;
        };
        combo_del {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp DEL>;
        };
        combo_undo {
            timeout-ms = <50>;
            key-positions = <14 15>;
            bindings = <&kp LG(Z)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "基本（大西配列）";
            bindings = <
  &kp Q                  &lt 1 ESC              &kp L                  &kp U                  &kp COMMA              &lt 3 SEMI             &kp DOT                  &kp F                  &kp W                  &kp R                  &kp Y                  &kp P
  &kp TAB                &kp E                  &kp I                  &kp A                  &kp O                  &kp MINUS              &mkp MB3                 &kp K                  &kp T                  &kp N                  &kp S                  &kp H                  &kp BSPC
  &kp LSHFT              &kp Z                  &lt 1 X                &kp C                  &kp V                  &kp BSPC               &kp DEL                  &kp ESC                &kp G                  &kp D                  &lt 6 M                &kp J                  &kp B                  &kp ENTER
  &kp LGUI               &kp LSHFT              &kp LCTRL              &kp LALT               &mt LGUI LANG2         &lt 5 TAB              &lt 4 SPACE              &lt 2 LANG1            &lt 1 ENTER            &kp RSHFT              &mkp MB1               &mkp MB3               &mkp MB2
  &kp LC(UP)             &kp LC(RIGHT)          &kp LC(DOWN)           &kp LC(LEFT)           &kp LG(SPACE)            &kp UP                 &kp RIGHT              &kp DOWN               &kp LEFT               &kp ENTER
            >;
            sensor-bindings = <&scroll_v &scroll_h>;
        };

        lower_layer {
            display-name = "数字・記号";
            bindings = <
  &trans                 &kp Q                  &kp LBKT               &kp N1                 &kp N2                 &kp N3                 &trans                   &m_paren               &m_dquote              &kp INT3               &kp EQUAL              &kp UNDER
  &trans                 &kp D                  &kp SEMI               &kp N4                 &kp N5                 &kp N6                 &trans                   &m_paren               &m_square              &kp KP_PLUS            &kp KP_MULTIPLY        &kp BSPC               &trans
  &trans                 &kp LGUI               &kp SQT                &kp N7                 &kp N8                 &kp N9                 &trans                   &trans                 &kp EXCL               &kp QMARK              &kp FSLH               &kp LC(LS(LA(Q)))      &kp MINUS              &trans
  &trans                 &trans                 &trans                 &kp KP_COMMA           &kp N0                 &kp DOT                &trans                   &trans                 &trans                 &kp QMARK              &trans                 &trans                 &trans
  &trans                 &trans                 &trans                 &trans                 &trans                   &trans                 &trans                 &trans                 &trans                 &trans
            >;
            sensor-bindings = <&scroll_v &scroll_h>;
        };

        nav_layer {
            display-name = "矢印・移動";
            bindings = <
  &trans                 &trans                 &trans                 &kp F14                &none                  &none                  &trans                   &trans                 &kp UP                 &trans                 &kp LG(RBKT)           &kp LG(BSLH)
  &trans                 &trans                 &trans                 &kp F15                &none                  &kp LC(LS(LA(COMMA)))  &trans                   &kp LEFT               &kp DOWN               &kp RIGHT              &kp RBKT               &kp BSLH               &trans
  &trans                 &trans                 &kp END                &kp HOME               &kp LS(LG(N2))         &kp LS(LG(N3))         &trans                   &trans                 &kp LC(A)              &kp LC(K)              &kp LC(E)              &kp LS(LA(U))          &none                  &trans
  &trans                 &trans                 &trans                 &trans                 &kp LS(LG(N5))         &kp LS(LG(N1))         &kp LS(LG(N4))           &trans                 &kp RSHFT              &none                  &trans                 &trans                 &trans
  &trans                 &trans                 &trans                 &trans                 &trans                   &trans                 &trans                 &trans                 &trans                 &trans
            >;
            sensor-bindings = <&scroll_v &scroll_h>;
        };

        special_layer {
            display-name = "記号と窓";
            bindings = <
  &trans                 &trans                 &kp LALT               &kp LGUI               &kp LSHFT              &kp AT                 &trans                   &trans                 &kp UP                 &kp LC(LS(LG(KP_SLASH))) &kp LC(LS(LG(KP_EQUAL))) &kp LC(LS(LG(KP_COMMA)))
  &trans                 &kp LBRC               &kp HASH               &kp DLLR               &kp LT                 &kp GT                 &trans                   &kp LEFT               &kp DOWN               &kp RIGHT              &kp LALT               &trans                 &trans
  &trans                 &kp PIPE               &kp LA(LG(BSLH))       &kp PLUS               &kp RBKT               &kp BSLH               &trans                   &trans                 &kp LG(N0)             &kp LC(LA(LG(SPACE)))  &trans                 &kp LC(LS(LA(LG(E))))  &trans                 &trans
  &trans                 &trans                 &trans                 &trans                 &kp LSHFT              &trans                 &trans                   &kp LG(KP_MINUS)       &kp LG(KP_PLUS)        &trans                 &trans                 &trans                 &trans
  &trans                 &trans                 &trans                 &trans                 &trans                   &trans                 &trans                 &trans                 &trans                 &trans
            >;
            sensor-bindings = <&scroll_v &scroll_h>;
        };

        macro_layer {
            display-name = "アプリと曲";
            bindings = <
  &trans                 &kp LA(LG(ESC))        &kp LS(LA(N3))         &kp LS(LA(N4))         &kp LS(LA(N1))         &kp LS(LA(N2))         &trans                   &kp LC(COMMA)          &trans                 &trans                 &trans                 &kp LC(LA(LG(SQT)))
  &trans                 &kp TAB                &trans                 &kp LC(LS(LA(I)))      &kp LC(LS(LA(O)))      &kp LC(LS(LA(P)))      &trans                   &kp LC(N3)             &kp LC(N4)             &kp LC(N5)             &kp LC(N8)             &kp DEL                &trans
  &trans                 &trans                 &trans                 &kp LG(Q)              &kp LG(W)              &kp LC(UP)             &trans                   &trans                 &kp F16                &kp LC(N6)             &kp LC(N7)             &kp LC(LA(LG(KP_N9)))  &kp LC(LA(LG(KP_N0)))  &trans
  &trans                 &trans                 &trans                 &trans                 &trans                 &kp LC(LS(LA(LG(Y))))  &trans                   &kp LC(LEFT)           &kp LC(RIGHT)          &trans                 &trans                 &trans                 &trans
  &trans                 &trans                 &trans                 &trans                 &trans                   &trans                 &trans                 &trans                 &trans                 &trans
            >;
            sensor-bindings = <&scroll_v &scroll_h>;
        };

        fkey_layer {
            display-name = "F キーと Bluetooth";
            bindings = <
  &trans                 &kp PG_DN              &kp F1                 &kp F2                 &kp F3                 &kp F4                 &trans                   &bt BT_SEL 0           &bt BT_SEL 1           &bt BT_SEL 2           &bt BT_SEL 3           &bt BT_CLR
  &trans                 &kp F5                 &kp F6                 &kp F7                 &kp F8                 &kp F23                &trans                   &out OUT_USB           &out OUT_BLE           &trans                 &trans                 &sys_reset             &bootloader
  &trans                 &kp F9                 &kp F10                &kp F11                &kp F12                &kp SPACE              &trans                   &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans
  &trans                 &kp LA(Z)              &trans                 &trans                 &trans                 &trans                 &trans                   &kp LA(SPACE)          &kp LG(SPACE)          &trans                 &trans                 &trans                 &trans
  &trans                 &trans                 &trans                 &trans                 &trans                   &trans                 &trans                 &trans                 &trans                 &trans
            >;
            sensor-bindings = <&scroll_v &scroll_h>;
        };

        scroll_layer {
            display-name = "スクロール";
            bindings = <
  &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                   &trans                 &trans                 &trans                 &trans                 &trans
  &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                   &trans                 &trans                 &trans                 &trans                 &trans                 &trans
  &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                   &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans
  &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                   &trans                 &trans                 &trans                 &trans                 &trans                 &trans
  &trans                 &trans                 &trans                 &trans                 &trans                   &trans                 &trans                 &trans                 &trans                 &trans
            >;
            sensor-bindings = <&scroll_v &scroll_h>;
        };

        mouse_layer {
            display-name = "マウス";
            bindings = <
  &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                   &trans                 &trans                 &trans                 &trans                 &trans
  &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                   &trans                 &mkp MB1               &mkp MB3               &mkp MB2               &trans                 &trans
  &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                   &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans
  &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                   &trans                 &trans                 &trans                 &trans                 &trans                 &trans
  &trans                 &trans                 &trans                 &trans                 &trans                   &trans                 &trans                 &trans                 &trans                 &trans
            >;
            sensor-bindings = <&scroll_v &scroll_h>;
        };
    };
};
